# Conexión del usuario dueño de los esquemas. La usan las migraciones y el ETL.
# Formato: postgresql://USUARIO:CLAVE@SERVIDOR:5432/tablero_oferta
TABLERO_BASE_DATOS=

# Conexión del usuario de solo lectura. La usa la API.
TABLERO_BASE_DATOS_LECTURA=

# Nombre que queda registrado en gobierno.cargas cuando se corre el ETL. Opcional.
TABLERO_RESPONSABLE=
